---
// Ejercicios del 1 al 4 en astro jeje
---

<div class="main-container">

  <section class="exercise-card">
    <div class="content">
      <h2>1. Saludo Personalizado</h2>
      <input 
        type="text" 
        id="nameInput" 
        placeholder="Escribe tu nombre..." 
      />
      <p id="welcomeMessage">Hola, invitado</p>
    </div>
  </section>

  <section class="exercise-card">
    <div class="content">
      <h2>2. Contador: <span id="display">0</span></h2>
      <div class="button-group">
        <button id="incrementBtn" class="btn-primary">Incrementar</button>
        <button id="resetBtn" class="btn-secondary">Reiniciar</button>
      </div>
    </div>
  </section>

  <section class="exercise-card">
    <div class="content">
      <h2>3. Visibilidad</h2>
      <button id="toggleBtn" class="btn-primary">Mostrar/Ocultar Mensaje</button>
      <p id="message" class="hidden">Solo se que no se nada</p>
    </div>
  </section>

  <section class="exercise-card">
    <div class="content">
      <h2>4. Alerta Personalizada</h2>
      <div class="alert-box">
        <input type="text" id="alertInput" placeholder="Escribe algo..." />
        <button id="alertBtn" class="btn-primary">Mostrar Alerta</button>
      </div>
    </div>
  </section>

</div>

<script>
  // Script Saludo
  const nameInput = document.getElementById('nameInput') as HTMLInputElement | null;
  const welcomeMsg = document.getElementById('welcomeMessage');
  if (nameInput && welcomeMsg) {
    nameInput.addEventListener('input', (e) => {
      const target = e.target as HTMLInputElement;
      welcomeMsg.textContent = target.value.trim() ? `Hola, ${target.value.trim()}` : 'Hola, invitado';
    });
  }

  // Script Contador
  let count: number = 0;
  const display = document.getElementById('display');
  const btnInc = document.getElementById('incrementBtn');
  const btnRes = document.getElementById('resetBtn');
  if (display && btnInc && btnRes) {
    btnInc.addEventListener('click', () => { count++; display.textContent = count.toString(); });
    btnRes.addEventListener('click', () => { count = 0; display.textContent = count.toString(); });
  }

  // Script Visibilidad
  const toggleBtn = document.getElementById('toggleBtn');
  const toggleMsg = document.getElementById('message');
  if (toggleBtn && toggleMsg) {
    toggleBtn.addEventListener('click', () => { toggleMsg.classList.toggle('hidden'); });
  }

  // Script Alerta
  const alertInput = document.getElementById('alertInput') as HTMLInputElement | null;
  const alertBtn = document.getElementById('alertBtn');
  if (alertInput && alertBtn) {
    alertBtn.addEventListener('click', () => {
      const val = alertInput.value.trim();
      alert(val ? val : "El campo está vacío");
    });
  }
</script>

<style>
  /* Contenedor Principal */
  .main-container {
    max-width: 600px;
    margin: 40px auto;
    display: flex;
    flex-direction: column;
    gap: 30px; /* Separación entre ejercicios */
    font-family: system-ui, -apple-system, sans-serif;
    padding: 20px;
  }

  /* Estilo de Tarjeta para todos los ejercicios */
  .exercise-card {
    background: #fff;
    padding: 25px;
    border: 1px solid #e1e1e1;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
  }

  h2 {
    margin-top: 0;
    font-size: 1.4rem;
    color: #222;
  }

  /* Inputs y Botones */
  input {
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 6px;
    font-size: 1rem;
    width: 100%;
    max-width: 300px; /* Aquí se limita el ancho para que no cruce toda la pantalla y se vea feo xd */
    box-sizing: border-box;
  }

  .button-group, .alert-box {
    display: flex;
    gap: 10px;
    margin-top: 10px;
    flex-wrap: wrap; /* Para que sea responsivo xddd */
  }

  button {
    padding: 10px 18px;
    border-radius: 6px;
    cursor: pointer;
    font-weight: 600;
    border: none;
    transition: background 0.2s;
  }

  .btn-primary { background: #007bff; color: white; }
  .btn-primary:hover { background: #0056b3; }

  .btn-secondary { background: #6c757d; color: white; }
  .btn-secondary:hover { background: #5a6268; }

  
  .hidden { display: none; }
  p { font-weight: 500; color: #444; margin-top: 15px; }
</style>