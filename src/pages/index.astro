---
import LayoutProyecto from '../layouts/LayoutProyecto.astro';
---

<LayoutProyecto title="Principal | Equipo 1">
  <div class="max-w-6xl w-full mx-auto">
    <header class="text-center mb-16 space-y-4">
      <h1 class="text-5xl md:text-7xl font-black tracking-tighter bg-clip-text text-transparent bg-gradient-to-r from-cyan-400 via-blue-500 to-purple-600">
        Equipo 1
      </h1>
    </header>

    <nav class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      
    <section class="group relative p-8 rounded-3xl bg-slate-900/50 border border-slate-800 hover:border-cyan-500/50 transition-all duration-300 hover:-translate-y-2 backdrop-blur-xl">
        <div class="text-4xl mb-4 group-hover:scale-110 transition-transform duration-300">🗒️</div>
        <h2 class="text-2xl font-bold mb-3 text-white">Ejercicios</h2>
        <p class="text-slate-400 text-sm leading-relaxed mb-6">20 ejercicios resueltos</p>
        <a href="/ejercicios/1" class="block w-full py-3 px-4 bg-cyan-600 hover:bg-cyan-500 text-white text-center rounded-xl font-semibold transition-colors">
            Ver Ejercicios
        </a>
    </section>
      <section class="group relative p-8 rounded-3xl bg-slate-900/50 border border-slate-800 hover:border-yellow-500/50 transition-all duration-300 hover:-translate-y-2 backdrop-blur-xl">
        <div class="text-4xl mb-4 group-hover:scale-110 transition-transform duration-300">🐾</div>
        <h2 class="text-2xl font-bold mb-3 text-white">Pokédex</h2>
        <p class="text-slate-400 text-sm leading-relaxed mb-6">Explora tus pokemons favoritos</p>
        <a href="/proyecto-final/pokemon" class="block w-full py-3 px-4 bg-yellow-600 hover:bg-yellow-500 text-white text-center rounded-xl font-semibold transition-colors">Explorar API</a>
      </section>

      <section class="group relative p-8 rounded-3xl bg-slate-900/50 border border-slate-800 hover:border-pink-500/50 transition-all duration-300 hover:-translate-y-2 backdrop-blur-xl">
        <div class="text-4xl mb-4 group-hover:scale-110 transition-transform duration-300">❤️</div>
        <h2 class="text-2xl font-bold mb-3 text-white">Favoritos</h2>
        <p class="text-slate-400 text-sm leading-relaxed mb-6">Tus pokemons favoritos en un solo lugar</p>
        <a href="/proyecto-final/pokemon/favoritos" class="block w-full py-3 px-4 bg-pink-600 hover:bg-pink-500 text-white text-center rounded-xl font-semibold transition-colors">Ver Colección</a>
      </section>

      <section class="group relative p-8 rounded-3xl bg-slate-900/50 border border-slate-800 hover:border-purple-500/50 transition-all duration-300 hover:-translate-y-2 backdrop-blur-xl">
        <div class="text-4xl mb-4 group-hover:scale-110 transition-transform duration-300">👥</div>
        <h2 class="text-2xl font-bold mb-3 text-white">Colaboradores</h2>
        <p class="text-slate-400 text-sm leading-relaxed mb-6">Créditos y perfiles de los desarrolladores participantes.</p>
        <a href="/proyecto-final/colaboradores" class="block w-full py-3 px-4 bg-purple-600 hover:bg-purple-500 text-white text-center rounded-xl font-semibold transition-colors">Ver Equipo</a>
      </section>

      <section class="group relative p-8 rounded-3xl bg-slate-900/50 border border-slate-800 hover:border-emerald-500/50 transition-all duration-300 hover:-translate-y-2 backdrop-blur-xl lg:col-span-2">
        <div class="flex flex-col md:flex-row items-center gap-6 text-center md:text-left">
          <div class="text-5xl group-hover:rotate-12 transition-transform duration-300">📖</div>
          <div class="flex-grow">
            <h2 class="text-2xl font-bold text-white">Documentación Técnica</h2>
            <p class="text-slate-400 text-sm">Documento del paso a paso y video</p>
          </div>
          <a href="/proyecto-final/documentacion" class="w-full md:w-auto py-3 px-8 bg-emerald-600 hover:bg-emerald-500 text-white text-center rounded-xl font-semibold transition-colors">Leer Guía</a>
        </div>
      </section>

    </nav>
  </div>
</LayoutProyecto>