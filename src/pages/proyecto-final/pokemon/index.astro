---
import LayoutProyecto from '../../../layouts/LayoutProyecto.astro';
import PokemonBuscador from '../../../components/proyecto-final/PokemonBuscador.astro';
import PokemonList from '../../../components/proyecto-final/PokemonList.astro';
import PokemonCategorias from '../../../components/proyecto-final/PokemonCategorias.astro';
import PokemonPaginacion from '../../../components/proyecto-final/PokemonPaginacion.astro';

// 1. LÓGICA DE PAGINACIÓN (Saber en qué página estamos)
const url = new URL(Astro.request.url);
const currentPage = parseInt(url.searchParams.get("page") || "1");
const itemsPerPage = 20;

// 2. FETCH DE DATOS (Para saber el total de Pokémon y configurar la paginación)
const res = await fetch(`https://pokeapi.co/api/v2/pokemon?limit=${itemsPerPage}&offset=${(currentPage - 1) * itemsPerPage}`);
const data = await res.json();
const totalPokemons = data.count; // Total aproximado: 1302
---

<LayoutProyecto title="Explorar Pokédex | Equipo 1">
  <div class="max-w-7xl mx-auto w-full py-10 px-4">
    
    <header class="text-center mb-12">
      <h1 class="text-6xl md:text-8xl font-black text-white mb-4 tracking-tighter">
        Poké<span class="text-transparent bg-clip-text bg-gradient-to-r from-yellow-400 to-orange-500">dex</span>
      </h1>
      <p class="text-slate-500 text-lg font-medium">
        Explora la base de datos oficial, filtra por tipos y colecciona tus favoritos.
      </p>
    </header>

    <PokemonBuscador />

    <div class="mt-10 pt-10 border-t border-slate-800/50">
        <p class="text-center text-[10px] font-black uppercase tracking-[0.3em] text-slate-600 mb-6">
            Filtrado por Elemento
        </p>
        <PokemonCategorias tipoActual={null} />
        
        <div class="flex justify-center mt-6">
            <a href="/proyecto-final/pokemon/categorias" class="group flex items-center gap-2 text-slate-500 hover:text-yellow-500 transition-all font-bold text-xs uppercase tracking-widest">
                <span class="bg-slate-900 p-2 rounded-lg group-hover:bg-yellow-500/10 transition-colors">📂</span> 
                Ver todas las categorías
            </a>
        </div>
    </div>

    <section class="mt-16">
      <div class="flex items-center gap-4 mb-8">
          <div class="h-px flex-grow bg-slate-800"></div>
          <h2 class="text-sm font-black text-slate-500 uppercase tracking-[0.4em]">Explorar Todos</h2>
          <div class="h-px flex-grow bg-slate-800"></div>
      </div>
      
      <PokemonList page={currentPage} />
    </section>

    <PokemonPaginacion 
        totalItems={totalPokemons} 
        itemsPerPage={itemsPerPage} 
        currentPage={currentPage} 
        baseUrl="/proyecto-final/pokemon" 
    />

  </div>
</LayoutProyecto>