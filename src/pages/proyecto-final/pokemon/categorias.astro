---
import Layout from '../../../layouts/LayoutProyecto.astro';
import PokemonCard from '../../../components/proyecto-final/PokemonCard.astro';
import PokemonCategorias from '../../../components/proyecto-final/PokemonCategorias.astro';

const url = new URL(Astro.request.url);
const tipo = url.searchParams.get("tipo");

let pokemons: any[] = [];
let nombreTipo = "";

if (tipo) {
  const res = await fetch(`https://pokeapi.co/api/v2/type/${tipo}`);
  const data = await res.json();
  
  pokemons = data.pokemon.slice(0, 40).map((p: any) => {
    const id = p.pokemon.url.split("/").filter(Boolean).pop();
    return {
      id,
      name: p.pokemon.name,
      image: `https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/${id}.png`
    };
  });
}
---

<Layout title="Categorías | Pokédex">
  <div class="max-w-7xl mx-auto w-full px-6">
    
    <header class="text-center space-y-4 mb-12">
        <h1 class="text-5xl md:text-7xl font-black tracking-tighter text-white">
            Tipos <span class="text-transparent bg-clip-text bg-gradient-to-r from-yellow-400 to-orange-500">Pokémon</span>
        </h1>
        <p class="text-slate-500 text-lg max-w-2xl mx-auto">
            Selecciona una categoría elemental para descubrir pokémons específicos de ese grupo.
        </p>
    </header>

    <PokemonCategorias tipoActual={tipo} />

    {tipo ? (
      <div class="mt-16">
        <div class="flex items-center gap-4 mb-10 border-b border-slate-800 pb-6">
            <div class="w-3 h-12 bg-yellow-500 rounded-full"></div>
            <h2 class="text-3xl font-bold text-white capitalize">Viendo Tipo: {tipo}</h2>
            <span class="ml-auto text-slate-600 font-mono">{pokemons.length} resultados</span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-6">
          {pokemons.map(p => <PokemonCard {...p} />)}
        </div>
      </div>
    ) : (
      <div class="mt-20 text-center p-20 bg-slate-900/20 border border-dashed border-slate-800 rounded-[3rem]">
          <div class="text-6xl mb-6 opacity-20">🔎</div>
          <p class="text-slate-500 text-xl italic">Selecciona un elemento arriba para comenzar la búsqueda...</p>
      </div>
    )}
  </div>
</Layout>