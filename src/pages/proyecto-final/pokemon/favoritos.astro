---
import LayoutProyecto from '../../../layouts/LayoutProyecto.astro';
import PokemonFavoritos from '../../../components/proyecto-final/PokemonFavoritos.astro';
---

<LayoutProyecto title="Mis Favoritos | Pokédex">
  <div class="max-w-7xl mx-auto w-full px-6">
    
    <header class="text-center mb-16 space-y-4">
        <h1 class="text-5xl md:text-7xl font-black tracking-tighter text-white">
            Colección <span class="text-transparent bg-clip-text bg-gradient-to-r from-pink-500 via-red-500 to-yellow-500">Favorita</span>
        </h1>
        <p class="text-slate-500 text-lg">Tus Pokémon elegidos.</p>
    </header>

    <PokemonFavoritos />

  </div>
</LayoutProyecto>