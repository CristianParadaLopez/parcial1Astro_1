---
import LayoutProyecto from '../../layouts/LayoutProyecto.astro';

const colaboradores = [
  {
    nombre: "Katy",
    rol: "Frontend Developer",
    github: "https://github.com/ViviLeech",
    avatar: "https://unavatar.io/github/ViviLeech", 
    descripcion: "Especialista en Kotlin y Diseño. Amante de la IA y los ositos cariñositos."
  },
  {
    nombre: "Luis",
    rol: "Backend Developer",
    github: "https://github.com/luisamaya1518-rgb",
    avatar: "https://unavatar.io/github/luisamaya1518-rgb",
    descripcion: "Programador Backend con experiencia en PHP y Kotline. La IA y yo somos uno."
  },
  {
    nombre: "Eunice",
    rol: "Diseñadora UI/UX",
    github: "https://github.com/eun-mar",
    avatar: "https://unavatar.io/github/eun-mar",
    descripcion: "Diseñadora UI/UX con experiencia en prototipado y desarrollo frontend."
  },
  {
    nombre: "Tania",
    rol: "Desarrolladora y Mecatrónica",
    github: "https://github.com/taniagochez",
    avatar: "https://unavatar.io/github/taniagochez",
    descripcion: "Desarrolladora con experiencia en Kotlin y mecatrónica. Apasionada por la robótica y la tecnología."
  },
  {
    nombre: "Cristian",
    rol: "Full Stack Developer",
    github: "https://github.com/CristianParadaLopez",
    avatar: "https://unavatar.io/github/CristianParadaLopez",
    descripcion: "Programador FullStack y optimización en la experiencia de usuario."
  }
];
---

<LayoutProyecto title="Colaboradores | Equipo 1">
  <div class="max-w-6xl mx-auto px-6 py-20">
    
    <header class="text-center mb-20">
      <h1 class="text-6xl md:text-8xl font-black text-white mb-6 tracking-tighter">
        El <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-600">Equipo</span>
      </h1>
      <p class="text-slate-500 text-lg max-w-2xl mx-auto font-medium">
        Desarrolladores apasionados que hicieron posible esta Pokédex interactiva utilizando Astro, Tailwind y PokéAPI.
      </p>
    </header>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {colaboradores.map(persona => (
        <div class="group relative p-8 bg-slate-900/40 border border-slate-800 rounded-[2.5rem] backdrop-blur-xl transition-all duration-500 hover:border-cyan-500/50 hover:-translate-y-2 flex flex-col h-full">
          
          <div class="absolute -inset-px bg-gradient-to-r from-cyan-500 to-blue-500 rounded-[2.5rem] opacity-0 group-hover:opacity-10 blur-xl transition-opacity"></div>

          <div class="relative flex flex-col items-center text-center gap-4">
            <div class="relative">
                <div class="absolute -inset-1 bg-cyan-500 rounded-full blur opacity-0 group-hover:opacity-20 transition"></div>
                <img 
                  src={persona.avatar} 
                  alt={persona.nombre} 
                  class="relative w-24 h-24 rounded-2xl object-cover border-2 border-slate-800 group-hover:border-cyan-500 transition-colors shadow-2xl"
                />
            </div>
            <div>
              <h2 class="text-2xl font-bold text-white">{persona.nombre}</h2>
              <span class="text-cyan-400 text-[10px] font-black uppercase tracking-[0.2em]">{persona.rol}</span>
            </div>
          </div>

          <p class="mt-6 text-slate-400 leading-relaxed italic text-sm flex-grow text-center">
            "{persona.descripcion}"
          </p>

          <div class="mt-8 relative z-20">
            <a 
              href={persona.github} 
              target="_blank" 
              rel="noopener noreferrer"
              class="flex items-center justify-center gap-2 w-full py-4 bg-slate-950 border border-slate-800 rounded-2xl text-slate-300 font-bold text-xs uppercase tracking-widest hover:bg-white hover:text-slate-950 hover:border-white transition-all duration-300"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
              GitHub Perfil
            </a>
          </div>
        </div>
      ))}
    </div>

    <footer class="mt-24 text-center p-12 bg-slate-950/50 border border-slate-900 rounded-[3rem]">
        <p class="text-slate-500 text-[10px] font-black uppercase tracking-[0.5em] mb-4 text-center">Proyecto Académico</p>
        <p class="text-slate-300 font-bold text-center">Hecho con ❤️ por el Equipo 1</p>
    </footer>

  </div>
</LayoutProyecto>