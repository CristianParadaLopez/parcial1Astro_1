---
import LayoutProyecto from '../../layouts/LayoutProyecto.astro';

// Configuración
const pdfPath = "/documentacion/parcial1Astro_1.pdf"; 
const youtubeID = "gxKYEU4ISU0"; 
---

<LayoutProyecto title="Documentación Técnica | Equipo 1">
  <div class="max-w-5xl mx-auto px-6 py-16">
    
    <header class="text-center mb-20">
      <h1 class="text-6xl md:text-8xl font-black text-white mb-6 tracking-tighter">
        Docu<span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-cyan-500">mentación</span>
      </h1>
      <p class="text-slate-500 text-lg max-w-2xl mx-auto font-medium">
        Paso a paso del desarrollo y video explicativo.
      </p>
    </header>

    <div class="flex flex-col gap-20">
      
      <section class="space-y-8">
        <div class="flex flex-col items-center text-center gap-2">
          <span class="bg-emerald-500/10 text-emerald-400 px-4 py-1 rounded-full text-xs font-black uppercase tracking-widest border border-emerald-500/20">
            Recurso Principal
          </span>
          <h2 class="text-4xl font-bold text-white">Manual Técnico del Proyecto</h2>
        </div>
        
        <div class="group relative bg-slate-950 border border-slate-800 rounded-[3rem] overflow-hidden shadow-[0_0_50px_rgba(0,0,0,0.5)] h-[850px] transition-all duration-500 hover:border-emerald-500/30">
          <iframe 
            src={`${pdfPath}#toolbar=0&view=FitH`} 
            class="w-full h-full border-none opacity-90 group-hover:opacity-100 transition-opacity"
            title="Documentación PDF"
          >
          </iframe>
          
          <div class="absolute inset-0 flex items-center justify-center -z-10 bg-slate-900">
             <p class="text-slate-500 italic">Cargando visor de documento...</p>
          </div>
        </div>
        
        <div class="flex justify-center">
            <a href={pdfPath} download class="inline-flex items-center gap-3 px-10 py-4 bg-emerald-600 hover:bg-emerald-500 text-slate-950 rounded-2xl font-black transition-all hover:scale-105 shadow-xl shadow-emerald-600/20">
               <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
               Descargar PDF Completo
            </a>
        </div>
      </section>

      <section class="max-w-4xl mx-auto w-full space-y-10 pt-10 border-t border-slate-800/50">
        <div class="text-center">
          <h2 class="text-3xl font-bold text-white mb-2">Video de Presentación</h2>
          <p class="text-slate-500 text-sm font-medium">Demostración del proyecto</p>
        </div>

        <div class="relative bg-slate-900 border border-slate-800 rounded-[2.5rem] overflow-hidden shadow-2xl aspect-video group">
          <div class="absolute -inset-2 bg-gradient-to-r from-red-600 to-purple-600 rounded-[2.5rem] blur opacity-10 group-hover:opacity-20 transition duration-1000"></div>
          <iframe 
            class="relative w-full h-full"
            src={`https://www.youtube.com/embed/${youtubeID}?rel=0&showinfo=0`} 
            title="Presentación" 
            allowfullscreen
          ></iframe>
        </div>
        
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            {['Astro ', 'Tailwind CSS','Ejercicios', 'PokeAPI'].map(tech => (
                <div class="py-3 px-4 bg-slate-900/50 border border-slate-800 rounded-xl text-center text-xs font-bold text-slate-400 uppercase tracking-widest">
                    {tech}
                </div>
            ))}
        </div>
      </section>

    </div>

    <footer class="mt-32 text-center">
        <div class="inline-block p-1 rounded-full bg-gradient-to-r from-transparent via-slate-800 to-transparent w-full mb-8"></div>
        <p class="text-slate-600 text-[10px] font-black uppercase tracking-[0.5em]">
            Equipo 1 - 2026 
        </p>
    </footer>

  </div>
</LayoutProyecto>