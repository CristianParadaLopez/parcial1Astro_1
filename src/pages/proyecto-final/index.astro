---
// 1. Importaciones de componentes y servicios
import LayoutProyecto from '../../layouts/LayoutProyecto.astro';
import PokemonBuscador from '../../components/proyecto-final/PokemonBuscador.astro';
import PokemonCard from '../../components/proyecto-final/PokemonCard.astro';
import { getPokemonList, getPokemonDetail } from '../../service/pokeApi.js';
import '../../styles/global.css';

// type for the list response
interface PokemonResult {
  name: string;
  url: string;
}

// 2. Lógica para obtener datos (Se ejecuta en el servidor al buildear o renderizar)
const data = await getPokemonList(20, 0);
const pokemonResults: PokemonResult[] = data.results;

// Obtenemos los detalles de cada pokemon para tener la imagen y el ID real
  const pokemonList = await Promise.all(
  pokemonResults.map(async (pokemon: PokemonResult) => {
    // Extraemos el ID de la URL para no hacer fetch extra si no quieres, 
    // pero fetch es más seguro para traer la imagen oficial.
    return await getPokemonDetail(pokemon.name);
  })
);
---

<LayoutProyecto title="Pokedex - Proyecto Final">
  <main class="container mx-auto px-4 py-8">
    <header class="text-center mb-10">
      <h1 class="text-4xl font-extrabold text-slate-800 mb-2">PokéAPI Explorer</h1>
      <p class="text-gray-600">Busca y explora tus Pokémon favoritos</p>
    </header>

    <section class="mb-10">
      <PokemonBuscador />
    </section>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6" id="pokemon-container">
      {
        pokemonList.map((pokemon) => (
          <PokemonCard 
            id={pokemon.id} 
            name={pokemon.name} 
            image={pokemon.sprites.other['official-artwork'].front_default} 
          />
        ))
      }
    </div>

    {pokemonList.length === 0 && (
      <p class="text-center text-red-500 mt-10">No se encontraron Pokémon.</p>
    )}
  </main>
</LayoutProyecto>