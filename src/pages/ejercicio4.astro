---
// Alerta.astro
---

<div>
  <input type="text" id="alertInput" placeholder="Escribe algo..." />
  <button id="alertBtn">Mostrar Alerta</button>
</div>

<script>
  const input = document.getElementById('alertInput') as HTMLInputElement | null;
  const btn = document.getElementById('alertBtn') as HTMLButtonElement | null;

  if (input && btn) {
    btn.addEventListener('click', () => {
      const message = input.value.trim();
      
      if (message) {
        alert(message);
      } else {
        alert("El campo está vacío");
      }
    });
  }
</script>

<style>
  div {
    display: flex;
    gap: 8px;
    font-family: sans-serif;
  }

  input, button {
    padding: 5px;
  }
</style>