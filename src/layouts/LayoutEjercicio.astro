---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | Ejercicios Básicos</title>
</head>
<body class="bg-slate-50 min-h-screen flex flex-col font-sans">
    <nav class="bg-white border-b border-slate-200 p-4 mb-8 shadow-sm">
        <div class="container mx-auto flex justify-between items-center">
            <div class="flex gap-6 items-center">
                <a href="/" class="text-slate-800 font-bold flex items-center gap-2 hover:text-blue-600 transition-colors">
                    <span>&larr;</span> Inicio
                </a>
                <a href="/proyecto-final" class="text-sm text-slate-600 hover:text-blue-500">Pokémon API</a>
            </div>
            <span class="text-slate-400 text-xs hidden sm:inline uppercase tracking-widest font-semibold">Parcial 2026</span>
        </div>
    </nav>

    <main class="container mx-auto px-4 flex-grow flex flex-col items-center">
        <header class="text-center mb-10">
            <h1 class="text-3xl font-extrabold text-slate-900 mb-2">{title}</h1>
            <div class="h-1.5 w-16 bg-blue-600 mx-auto rounded-full"></div>
        </header>

        <section class="w-full flex justify-center pb-20">
            <slot />
        </section>
    </main>

    <footer class="bg-white border-t border-slate-200 py-6">
        <p class="text-center text-slate-400 text-sm italic">
            Práctica de DOM y Manipulación de Eventos con Astro
        </p>
    </footer>
</body>
</html>