---
import '../styles/global.css';
interface Props { title: string; }
const { title } = Astro.props;

const colaboradores = [
  { github: "ViviLeech" },
  { github: "luisamaya1518-rgb" },
  { github: "eun-mar" },
  { github: "taniagochez" },
  { github: "CristianParadaLopez" }
];
---
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
</head>
<body class="bg-[#020617] text-slate-200 min-h-screen flex flex-col font-sans selection:bg-cyan-500/30">
    
    <nav class="fixed top-0 left-0 right-0 z-50 bg-slate-950/80 backdrop-blur-xl border-b border-slate-800/50">
        <div class="max-w-7xl mx-auto px-6 h-20 flex justify-between items-center">
            <a href="/" class="flex items-center gap-3 group">
                <div class="w-10 h-10 bg-gradient-to-br from-cyan-500 via-blue-600 to-purple-600 rounded-xl flex items-center justify-center shadow-lg group-hover:rotate-12 transition-all">
                    <span class="text-white font-black">E1</span>
                </div>
                <span class="text-xl font-bold tracking-tighter text-white">EQUIPO 1</span>
            </a>
            
            <div class="flex items-center gap-8">
                <div class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-400">
                    <a href="/ejercicios/1" class="hover:text-cyan-400 transition-colors">Ejercicios</a>
                    <a href="/proyecto-final/colaboradores" class="hover:text-cyan-400 transition-colors">Equipo</a>
                    <a href="/proyecto-final/pokemon" class="hover:text-yellow-400 transition-colors">Pokédex</a>
                    <a href="/proyecto-final/pokemon/categorias" class="hover:text-cyan-400 transition-colors">Categorías</a>
                    <a href="/proyecto-final/pokemon/favoritos" class="hover:text-pink-400 transition-colors">Favoritos</a>
                </div>
                <span class="px-3 py-1 bg-slate-900/50 border border-slate-700 rounded-full text-[10px] font-bold text-slate-500 uppercase tracking-widest">Parcial 2026</span>
            </div>
        </div>
    </nav>

    <main class="flex-grow flex flex-col items-center pt-32 pb-20 px-4">
        <slot />
    </main>

    <footer class="py-16 border-t border-slate-900 bg-slate-950/30">
        <div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-10">
            
            <div class="flex flex-col gap-4">
                <h3 class="text-white font-black uppercase tracking-widest text-sm">Nuestro Equipo</h3>
                <p class="text-slate-500 text-sm max-w-xs">
                    Desarrollado por <span class="text-white font-bold">5 Integrantes</span> apasionados por el código.
                </p>
                <div class="flex -space-x-3 overflow-hidden">
                    {colaboradores.map((persona) => (
                        <img 
                            class="inline-block h-10 w-10 rounded-full ring-2 ring-slate-950 object-cover hover:grayscale-0 transition-all duration-300 hover:scale-110 hover:z-10" 
                            src={`https://unavatar.io/github/${persona.github}`} 
                            alt={persona.github} 
                        />
                    ))}
                </div>
            </div>

            <div class="flex flex-col items-center md:items-end gap-4">
                <h3 class="text-white font-black uppercase tracking-widest text-sm text-right">Repositorio Oficial</h3>
                <a 
                    href="https://github.com/CristianParadaLopez/parcial1Astro_1" 
                    target="_blank" 
                    class="group flex items-center gap-4 bg-slate-900/50 p-4 rounded-2xl border border-slate-800 hover:border-white transition-all shadow-xl"
                >
                    <div class="text-right hidden sm:block">
                        <p class="text-[10px] text-slate-500 font-bold uppercase tracking-tighter">GitHub Repo</p>
                        <p class="text-white font-bold text-xs uppercase tracking-widest">Ver Código Fuente</p>
                    </div>
                    <svg class="w-8 h-8 text-white group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                    </svg>
                </a>
                <p class="text-slate-600 text-[9px] font-bold uppercase tracking-[0.4em] mt-2">Última actualización: 2026</p>
            </div>

        </div>
    </footer>
</body>
</html>