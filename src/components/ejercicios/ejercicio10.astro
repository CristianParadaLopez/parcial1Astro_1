---
// components/ejercicios/DetectorCambios.astro
import LayoutEjercicio from '../../layouts/LayoutEjercicio.astro';
---

<LayoutEjercicio title="10. Detector de Cambios">
  <div class="max-w-md mx-auto bg-slate-900 p-8 rounded-2xl shadow-2xl border border-slate-800 flex flex-col gap-4">
    <h2 class="text-xl font-bold text-white text-center tracking-tight">Detector de Límite</h2>
    
    <input 
      type="text" 
      id="detectorInput" 
      placeholder="Escribe aquí..." 
      class="w-full px-4 py-2 rounded-lg bg-slate-800 border border-slate-700 text-white placeholder:text-slate-500 focus:outline-none focus:border-cyan-400 transition-colors"
    />
    
    <div class="flex flex-col gap-2 text-center">
      <p id="contadorChars" class="text-slate-400 font-medium">
        Caracteres: <span class="text-cyan-400 font-bold">0</span> / 10
      </p>
      
      <p id="alertaLimite" class="hidden px-4 py-2 bg-rose-500/10 border border-rose-500/50 text-rose-500 font-bold rounded-lg animate-pulse">
        ⚠️ ¡Has superado el límite de 10 caracteres!
      </p>
    </div>
  </div>
</LayoutEjercicio>

<script>
  const detectorInput = document.getElementById('detectorInput') as HTMLInputElement | null;
  const contadorChars = document.getElementById('contadorChars');
  const alertaLimite  = document.getElementById('alertaLimite');

  if (detectorInput && contadorChars && alertaLimite) {
    detectorInput.addEventListener('input', () => {
      const len = detectorInput.value.length;
      
      contadorChars.innerHTML = `Caracteres: <span class="text-cyan-400 font-bold">${len}</span> / 10`;
      
      if (len > 10) {
        alertaLimite.classList.remove('hidden');
        detectorInput.classList.replace('focus:border-cyan-400', 'focus:border-rose-500');
        detectorInput.classList.add('border-rose-500');
      } else {
        alertaLimite.classList.add('hidden');
        detectorInput.classList.replace('focus:border-rose-500', 'focus:border-cyan-400');
        detectorInput.classList.remove('border-rose-500');
      }
    });
  }
</script>