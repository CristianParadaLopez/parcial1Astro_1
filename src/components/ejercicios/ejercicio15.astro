---
// components/ejercicios/EnlacePrevencion.astro
import LayoutEjercicio from '../../layouts/LayoutEjercicio.astro';
---

<LayoutEjercicio title="15. Prevención de Enlace">
  <div class="max-w-md mx-auto bg-slate-900 p-8 rounded-2xl shadow-2xl border border-slate-800 text-center">
    <h2 class="text-xl font-bold text-white mb-6 tracking-tight">Interceptor de Navegación</h2>
    
    <div class="space-y-6">
      <a 
        href="https://google.com" 
        id="preventLink" 
        class="inline-block px-6 py-3 rounded-xl border border-cyan-500/30 text-cyan-400 font-semibold hover:bg-cyan-500/10 hover:border-cyan-400 transition-all duration-300 active:scale-95"
      >
        Ir a Google.com
      </a>

      <div class="min-h-[50px] flex items-center justify-center">
        <p id="message" class="text-slate-500 text-sm italic transition-all duration-300"></p>
      </div>
    </div>
  </div>
</LayoutEjercicio>

<script>
  const link = document.getElementById('preventLink');
  const message = document.getElementById('message');

  link?.addEventListener('click', (event) => {
    // Evitamos que el navegador siga el enlace
    event.preventDefault();
    
    if (message) {
      // Aplicamos el estilo del modelo de ejemplo: text-cyan-400 font-bold
      message.innerHTML = `⚠️ <span class="text-cyan-400 font-bold animate-in fade-in zoom-in duration-300">Comportamiento predeterminado prevenido</span>`;
      
      // Efecto visual en el botón para indicar que fue bloqueado
      link.classList.add('border-rose-500', 'text-rose-500');
      link.classList.remove('text-cyan-400', 'border-cyan-500/30');
      
      setTimeout(() => {
        link.classList.remove('border-rose-500', 'text-rose-500');
        link.classList.add('text-cyan-400', 'border-cyan-500/30');
      }, 1000);
    }
  });
</script>