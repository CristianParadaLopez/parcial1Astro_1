---
// components/ejercicios/BuscadorRealTime.astro
import LayoutEjercicio from '../../layouts/LayoutEjercicio.astro';
---

<LayoutEjercicio title="11. Buscador en Tiempo Real">
  <div class="max-w-md mx-auto bg-slate-900 p-8 rounded-2xl shadow-2xl border border-slate-800">
    <h2 class="text-xl font-bold text-white mb-6 text-center tracking-tight">Filtro de Inventario</h2>
    
    <div class="relative mb-6">
      <input 
        type="text" 
        id="buscadorInput" 
        placeholder="Buscar fruta..." 
        class="w-full px-4 py-3 pl-10 rounded-xl bg-slate-800 border border-slate-700 text-white placeholder:text-slate-500 focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 transition-all"
      />
      <span class="absolute left-3 top-3.5 text-slate-500">🔍</span>
    </div>

    <ul id="listaFrutas" class="space-y-2 max-h-60 overflow-y-auto pr-2 custom-scrollbar">
      <li class="px-4 py-2 rounded-lg bg-slate-800 text-slate-300 border border-slate-700/50 hover:border-cyan-400/50 hover:bg-slate-700/50 transition-all cursor-default">Manzana</li>
      <li class="px-4 py-2 rounded-lg bg-slate-800 text-slate-300 border border-slate-700/50 hover:border-cyan-400/50 hover:bg-slate-700/50 transition-all cursor-default">Banana</li>
      <li class="px-4 py-2 rounded-lg bg-slate-800 text-slate-300 border border-slate-700/50 hover:border-cyan-400/50 hover:bg-slate-700/50 transition-all cursor-default">Naranja</li>
      <li class="px-4 py-2 rounded-lg bg-slate-800 text-slate-300 border border-slate-700/50 hover:border-cyan-400/50 hover:bg-slate-700/50 transition-all cursor-default">Uva</li>
      <li class="px-4 py-2 rounded-lg bg-slate-800 text-slate-300 border border-slate-700/50 hover:border-cyan-400/50 hover:bg-slate-700/50 transition-all cursor-default">Sandía</li>
      <li class="px-4 py-2 rounded-lg bg-slate-800 text-slate-300 border border-slate-700/50 hover:border-cyan-400/50 hover:bg-slate-700/50 transition-all cursor-default">Melón</li>
      <li class="px-4 py-2 rounded-lg bg-slate-800 text-slate-300 border border-slate-700/50 hover:border-cyan-400/50 hover:bg-slate-700/50 transition-all cursor-default">Fresa</li>
      <li class="px-4 py-2 rounded-lg bg-slate-800 text-slate-300 border border-slate-700/50 hover:border-cyan-400/50 hover:bg-slate-700/50 transition-all cursor-default">Kiwi</li>
    </ul>

    <p id="sinResultados" class="hidden mt-4 text-center text-slate-500 italic animate-pulse">
      No se encontraron frutas... 
    </p>
  </div>
</LayoutEjercicio>

<script>
  const buscadorInput = document.getElementById('buscadorInput') as HTMLInputElement | null;
  const listaFrutas   = document.getElementById('listaFrutas');
  const sinResultados = document.getElementById('sinResultados');

  if (buscadorInput && listaFrutas && sinResultados) {
    buscadorInput.addEventListener('input', () => {
      const query  = buscadorInput.value.toLowerCase().trim();
      const items  = listaFrutas.querySelectorAll('li');
      let visibles = 0;

      items.forEach(item => {
        const texto = item.textContent?.toLowerCase() || "";
        const coincide = texto.includes(query);
        
       
        if (coincide) {
          item.classList.remove('hidden');
          item.classList.add('flex');
          visibles++;
        } else {
          item.classList.add('hidden');
          item.classList.remove('flex');
        }
      });

      sinResultados.classList.toggle('hidden', visibles > 0);
    });
  }
</script>

<style>
  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #334155;
    border-radius: 10px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: #06b6d4;
  }
</style>