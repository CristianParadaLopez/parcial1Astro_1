---
// components/ejercicios/ejercicio1.astro
import LayoutEjercicio from '../../layouts/LayoutEjercicio.astro';
---
<LayoutEjercicio title="Saludo Personalizado">
  <input type="text" id="nombre" placeholder="Escribe tu nombre..." />
  <p id="output">Hola, <span class="text-cyan-400 font-bold">Invitado</span></p>
</LayoutEjercicio>

<script>
  const input = document.getElementById('nombre') as HTMLInputElement;
  const output = document.getElementById('output');
  input?.addEventListener('input', () => {
    if(output) output.innerHTML = `Hola, <span class="text-cyan-400 font-bold">${input.value || 'Invitado'}</span>`;
  });
</script>