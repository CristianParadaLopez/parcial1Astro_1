---
//Cambiotema.astro
---
<style>
body{
    margin:0;
    font-family:Segoe UI;
    background:#f4f6fb;
    transition:.3s;
}

/* NAVBAR */
.navbar{
    background:#4f46e5;
    color:white;
    padding:15px 30px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    font-weight:bold;
    font-size:18px;
}

/* BOTON NAVBAR */
.tema-btn{
    background:white;
    color:#4f46e5;
    border:none;
    padding:8px 15px;
    border-radius:8px;
    cursor:pointer;
    font-weight:bold;
}

/* CONTENEDOR */
.container{
    display:flex;
    justify-content:center;
    align-items:center;
    height:85vh;
}

/* CARD */
.card{
    width:320px;
    padding:25px;
    border-radius:18px;
    text-align:center;
    background:white;
    color:#333;
    box-shadow:0 10px 25px rgba(0,0,0,.2);
    transition:.3s;
}

/* MODO OSCURO */
.dark-body{
    background:#121212;
}

.dark-card{
    background:#1e1e1e;
    color:white;
}

.dark-nav{
    background:#111827;
}
</style>
</head>
<body>

<!-- NAVBAR -->
<div class="navbar" id="nav">
Tema
<button class="tema-btn" id="btnTema">Modo Oscuro</button>
</div>

<!-- CONTENIDO -->
<div class="container">
<div class="card" id="card">
<h2>Tarjeta de Ejercicio 7</h2>
<p>Presiona el botón para cambiar el tema.</p>
</div>
</div>

<script>
    // @ts-nocheck
let oscuro=false;

document.getElementById("btnTema").addEventListener("click",()=>{

    oscuro=!oscuro;

    document.body.classList.toggle("dark-body");
    document.getElementById("card").classList.toggle("dark-card");
    document.getElementById("nav").classList.toggle("dark-nav");

    document.getElementById("btnTema").textContent =
        oscuro ? "Modo Claro" : "Modo Oscuro";
});
</script>

</body>
</html>