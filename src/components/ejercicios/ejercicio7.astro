---
// components/ejercicios/CambioTema.astro
import LayoutEjercicio from '../../layouts/LayoutEjercicio.astro';
---

<LayoutEjercicio title="Interruptor de Temas">
  <div 
    id="tema-container" 
    class="w-full max-w-md mx-auto overflow-hidden rounded-2xl bg-slate-100 shadow-xl transition-all duration-500 border border-slate-200"
  >
    
    <nav id="ejercicio-nav" class="bg-indigo-600 text-white p-4 flex justify-between items-center transition-colors duration-500">
      <span class="font-bold tracking-tight">Personalizador</span>
      <button 
        id="btnTema" 
        class="bg-white text-indigo-600 px-4 py-1.5 rounded-lg font-bold text-sm hover:scale-105 active:scale-95 transition-all shadow-sm"
      >
        Modo Oscuro
      </button>
    </nav>

    <div class="p-10 text-center">
      <div class="space-y-4">
        <h2 id="titulo" class="text-2xl font-black text-slate-900 transition-colors duration-500">
          Tarjeta de Ejercicio
        </h2>
        <p id="descripcion" class="text-slate-700 transition-colors duration-500 font-medium">
          Presiona el botón superior para alternar entre el lado claro y el oscuro de la fuerza.
        </p>
        
        <div id="divisor" class="h-1.5 w-16 bg-indigo-500 mx-auto rounded-full transition-all duration-500"></div>
      </div>
    </div>

  </div>
</LayoutEjercicio>

<script>
  const btn = document.getElementById("btnTema") as HTMLButtonElement;
  const container = document.getElementById("tema-container");
  const nav = document.getElementById("ejercicio-nav");
  const titulo = document.getElementById("titulo");
  const descripcion = document.getElementById("descripcion");
  const divisor = document.getElementById("divisor");

  let isDark = false;

  btn?.addEventListener("click", () => {
    isDark = !isDark;

    if (isDark) {
      // --- MODO OSCURO ---
      container?.classList.replace("bg-slate-100", "bg-slate-900");
      container?.classList.replace("border-slate-200", "border-slate-800");
      
      // Texto: de oscuro a blanco/claro
      titulo?.classList.replace("text-slate-900", "text-white");
      descripcion?.classList.replace("text-slate-700", "text-slate-300");
      
      nav?.classList.replace("bg-indigo-600", "bg-slate-950");
      divisor?.classList.replace("bg-indigo-500", "bg-cyan-400");
      
      btn.textContent = "Modo Claro";
      btn.classList.replace("text-indigo-600", "text-slate-900");
    } else {
      // --- MODO CLARO ---
      container?.classList.replace("bg-slate-900", "bg-slate-100");
      container?.classList.replace("border-slate-800", "border-slate-200");
      
      // Texto: de blanco/claro a oscuro
      titulo?.classList.replace("text-white", "text-slate-900");
      descripcion?.classList.replace("text-slate-300", "text-slate-700");
      
      nav?.classList.replace("bg-slate-950", "bg-indigo-600");
      divisor?.classList.replace("bg-cyan-400", "bg-indigo-500");
      
      btn.textContent = "Modo Oscuro";
      btn.classList.replace("text-slate-900", "text-indigo-600");
    }
  });
</script>