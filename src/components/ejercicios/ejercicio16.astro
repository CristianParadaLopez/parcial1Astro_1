<title>Ejercicio 16</title>

<script src="https://cdn.tailwindcss.com"></script>

<div class="p-5 font-sans">
  <p 
    id="interactiveText" 
    class="text-xl cursor-default transition-colors duration-300 text-white"
  >
    Texto rojo!
  </p>
</div>

<script>
  const text = document.getElementById('interactiveText');

  text?.addEventListener('mouseenter', () => {
    text.classList.replace('text-white', 'text-red-600');
  });

  text?.addEventListener('mouseleave', () => {
    text.classList.replace('text-red-600', 'text-white');
  });
</script>