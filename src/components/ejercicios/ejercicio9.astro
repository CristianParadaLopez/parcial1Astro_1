---
// components/ejercicios/NombreCompleto.astro
import LayoutEjercicio from '../../layouts/LayoutEjercicio.astro';
---

<LayoutEjercicio title="9. Nombre Completo Automático">
  <div class="max-w-md mx-auto bg-slate-900 p-8 rounded-2xl shadow-2xl border border-slate-800">
    <h2 class="text-xl font-bold text-white mb-6 text-center tracking-tight">Identificador de Usuario</h2>
    
    <div class="flex flex-col sm:flex-row gap-3">
      <input 
        type="text" 
        id="inputNombre" 
        placeholder="Nombre..." 
        class="flex-1 px-4 py-2 rounded-lg bg-slate-800 border border-slate-700 text-white placeholder:text-slate-500 focus:outline-none focus:border-cyan-400 transition-colors"
      />
      <input 
        type="text" 
        id="inputApellido" 
        placeholder="Apellido..." 
        class="flex-1 px-4 py-2 rounded-lg bg-slate-800 border border-slate-700 text-white placeholder:text-slate-500 focus:outline-none focus:border-cyan-400 transition-colors"
      />
    </div>

    <p id="nombreCompleto" class="mt-6 text-center text-slate-300 text-lg">
      Tu nombre completo aparecerá aquí
    </p>
  </div>
</LayoutEjercicio>

<script>
  const inputNombre = document.getElementById('inputNombre') as HTMLInputElement | null;
  const inputApellido = document.getElementById('inputApellido') as HTMLInputElement | null;
  const nombreCompleto = document.getElementById('nombreCompleto');

  if (inputNombre && inputApellido && nombreCompleto) {
    const actualizarNombre = () => {
      const nombre = inputNombre.value.trim();
      const apellido = inputApellido.value.trim();
      const completo = [nombre, apellido].filter(Boolean).join(' ');

      if (completo) {
        nombreCompleto.innerHTML = `Hola, <span class="text-cyan-400 font-bold">${completo}</span>`;
      } else {
        nombreCompleto.textContent = 'Tu nombre completo aparecerá aquí';
      }
    };

    inputNombre.addEventListener('input', actualizarNombre);
    inputApellido.addEventListener('input', actualizarNombre);
  }
</script>