---
// components/ejercicios/ejercicio1.astro
import LayoutEjercicio from '../../layouts/LayoutEjercicio.astro';
---

<LayoutEjercicio title="Formulario con validación">
  <form id="myForm" class="flex flex-col gap-4 max-w-sm">
    <input type="text" id="username" placeholder="Nombre de usuario..." class="border p-2 rounded" />
    <input type="email" id="email" placeholder="Correo electrónico..." class="border p-2 rounded" />
    <button type="submit" class="bg-blue-500 hover:bg-blue-600 text-white p-2 rounded transition-colors">
      Enviar
    </button>
  </form>
  
  <p id="message" class="mt-4 font-medium"></p>
</LayoutEjercicio>

<script>
  const form = document.getElementById('myForm') as HTMLFormElement;
  const usernameInput = document.getElementById('username') as HTMLInputElement;
  const emailInput = document.getElementById('email') as HTMLInputElement;
  const message = document.getElementById('message');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    // Validamos si algún campo está vacío
    if (!usernameInput.value.trim() || !emailInput.value.trim()) {
      if (message) {
        message.textContent = '❌ Por favor, completa todos los campos.';
        message.classList.remove('text-green-600');
        message.classList.add('text-red-600');
      }
      return;
    }

    // Si todo está bien, mostramos éxito
    if (message) {
      message.textContent = `✅ ¡Gracias por registrarte, ${usernameInput.value}!`;
      message.classList.remove('text-red-600');
      message.classList.add('text-green-600');
    }

    // Reseteamos el formulario
    form.reset();
  });
</script>