---
import LayoutEjercicio from '../../layouts/LayoutEjercicio.astro';
---

<LayoutEjercicio title="Formulario con Validación">
  <div class="max-w-md mx-auto bg-slate-900 p-8 rounded-2xl shadow-2xl border border-slate-800 text-center">
    <h2 class="text-xl font-bold text-white mb-6 tracking-tight">Registro de Usuario</h2>
    
    <div class="space-y-4">
      <input 
        type="text" 
        id="nameInput" 
        placeholder="Escribe tu nombre..." 
        class="w-full px-4 py-2 rounded-lg bg-slate-800 border border-slate-700 text-white placeholder:text-slate-500 focus:outline-none focus:border-cyan-400 transition-colors"
      />
      
      <input 
        type="text" 
        id="emailInput" 
        placeholder="Escribe tu email..." 
        class="w-full px-4 py-2 rounded-lg bg-slate-800 border border-slate-700 text-white placeholder:text-slate-500 focus:outline-none focus:border-cyan-400 transition-colors"
      />

      <div class="mt-6 p-4 bg-slate-950 rounded-xl border border-slate-800">
        <p id="welcomeMessage" class="text-slate-300 text-lg">
          Hola, invitado
        </p>
      </div>
    </div>
  </div>
</LayoutEjercicio>

<script>
  const nameInput = document.getElementById('nameInput') as HTMLInputElement | null;
  const message = document.getElementById('welcomeMessage');

  if (nameInput && message) {
    nameInput.addEventListener('input', (e) => {
      const target = e.target as HTMLInputElement;
      const name = target.value.trim();
      
      if (name) {
        message.innerHTML = `Hola, <span class="text-cyan-400 font-bold">${name}</span>`;
      } else {
        message.textContent = 'Hola, invitado';
      }
    });
  }
</script>