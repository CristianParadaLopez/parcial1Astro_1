---
// components/ejercicios/Alerta.astro
import LayoutEjercicio from '../../layouts/LayoutEjercicio.astro';
---

<LayoutEjercicio title="Sistema de Alertas">
  <div class="flex gap-3 items-center">
    <input 
      type="text" 
      id="alertInput" 
      placeholder="Escribe algo..." 
      class="px-4 py-2 rounded bg-slate-800 border border-slate-700 text-white focus:outline-none focus:border-cyan-400 transition-colors"
    />
    <button 
      id="alertBtn" 
      class="px-4 py-2 bg-cyan-500 hover:bg-cyan-600 text-slate-900 font-bold rounded transition-colors"
    >
      Mostrar Alerta
    </button>
  </div>
</LayoutEjercicio>

<script>
  const input = document.getElementById('alertInput') as HTMLInputElement | null;
  const btn = document.getElementById('alertBtn') as HTMLButtonElement | null;

  if (input && btn) {
    btn.addEventListener('click', () => {
      const message = input.value.trim();
      
      if (message) {
        alert(message);
      } else {
        alert("El campo está vacío");
      }
    });
  }
</script>