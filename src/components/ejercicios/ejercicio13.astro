---
// components/ejercicios/TeclaPresionada.astro
import LayoutEjercicio from '../../layouts/LayoutEjercicio.astro';
---

<LayoutEjercicio title="13. Detector de Teclado">
  <div class="max-w-md mx-auto bg-slate-900 p-8 rounded-2xl shadow-2xl border border-slate-800 text-center">
    <h2 class="text-xl font-bold text-white mb-6 tracking-tight text-center">Monitor de Eventos</h2>
    
    <div class="space-y-6">
      <input 
        type="text" 
        id="keyInput" 
        placeholder="Escribe algo aquí..." 
        class="w-full px-4 py-3 rounded-xl bg-slate-800 border border-slate-700 text-white placeholder:text-slate-500 focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 transition-all text-center"
      />
      
      <div class="py-4 bg-slate-950 rounded-lg border border-slate-800">
        <p id="mensaje" class="text-slate-400 font-medium">
          Última tecla presionada: <span class="text-cyan-400 font-bold">—</span>
        </p>
      </div>
    </div>
  </div>
</LayoutEjercicio>

<script>
  const input = document.getElementById('keyInput') as HTMLInputElement | null;
  const mensaje = document.getElementById('mensaje');

  input?.addEventListener('keydown', (event) => {
    if (mensaje) {
      const keyName = event.key === ' ' ? 'Espacio' : event.key;
      
      mensaje.innerHTML = `Última tecla presionada: <span class="text-cyan-400 font-bold text-xl animate-in fade-in zoom-in duration-150 inline-block">${keyName}</span>`;
    }
  });
</script>