---
// components/ejercicios/CambiadorTexto.astro
import LayoutEjercicio from '../../layouts/LayoutEjercicio.astro';
---

<LayoutEjercicio title="12. Cambiador de Texto">
  <div class="max-w-md mx-auto bg-slate-900 p-10 rounded-2xl shadow-2xl border border-slate-800 text-center">
    <h2 class="text-xl font-bold text-white mb-8 tracking-tight">Interacción de Botón</h2>
    
    <div class="flex flex-col items-center gap-6">
      <button 
        id="toggleTextBtn" 
        class="group relative px-8 py-4 bg-slate-800 border border-slate-700 rounded-xl overflow-hidden transition-all duration-300 hover:border-cyan-400 active:scale-95"
      >
        <span id="btnLabel" class="relative z-10 text-cyan-400 font-bold text-lg transition-colors group-hover:text-white">
          Haz clic aquí
        </span>
        
        <div class="absolute inset-0 bg-gradient-to-r from-cyan-500 to-blue-600 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
      </button>

      <p class="text-slate-500 text-sm italic">
        El estado del botón cambia con cada interacción
      </p>
    </div>
  </div>
</LayoutEjercicio>

<script>
  const toggleTextBtn = document.getElementById('toggleTextBtn');
  const btnLabel = document.getElementById('btnLabel');
  let clicRealizado = false;

  if (toggleTextBtn && btnLabel) {
    toggleTextBtn.addEventListener('click', () => {
      clicRealizado = !clicRealizado;
      
      btnLabel.textContent = clicRealizado ? '¡Has hecho clic!' : 'Haz clic aquí';
      
      if (clicRealizado) {
        toggleTextBtn.classList.add('border-cyan-400/50');
      } else {
        toggleTextBtn.classList.remove('border-cyan-400/50');
      }
    });
  }
</script>