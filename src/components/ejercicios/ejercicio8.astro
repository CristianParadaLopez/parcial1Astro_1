---
// components/ejercicios/MensajeCondicional.astro
import LayoutEjercicio from '../../layouts/LayoutEjercicio.astro';
---

<LayoutEjercicio title="Mensaje Condicional">
  <div class="max-w-sm mx-auto bg-slate-900 p-8 rounded-2xl shadow-2xl border border-slate-800 text-center">
    <h2 class="text-xl font-bold text-white mb-6">Elige una opción</h2>

    <div class="flex flex-wrap justify-center gap-4">
      <button 
        id="btnA" 
        class="px-6 py-3 bg-gradient-to-r from-emerald-500 to-green-600 text-white font-bold rounded-xl hover:scale-110 active:scale-95 transition-all shadow-lg shadow-emerald-900/20"
      >
        Mensaje A
      </button>

      <button 
        id="btnB" 
        class="px-6 py-3 bg-gradient-to-r from-rose-500 to-red-600 text-white font-bold rounded-xl hover:scale-110 active:scale-95 transition-all shadow-lg shadow-rose-900/20"
      >
        Mensaje B
      </button>
    </div>

    <div id="mensaje" class="mt-8 min-h-[40px] flex items-center justify-center">
      <p class="text-slate-400 italic">Esperando selección...</p>
    </div>
  </div>
</LayoutEjercicio>

<script>
  const mensajeDiv = document.getElementById("mensaje") as HTMLDivElement;
  const btnA = document.getElementById("btnA");
  const btnB = document.getElementById("btnB");

  const actualizarMensaje = (texto: string, colorClass: string) => {
    if (mensajeDiv) {
      mensajeDiv.innerHTML = `<span class="${colorClass} font-bold text-xl animate-in fade-in zoom-in duration-300">${texto}</span>`;
    }
  };

  btnA?.addEventListener("click", () => {
    actualizarMensaje("Este es el mensaje A", "text-emerald-400");
  });

  btnB?.addEventListener("click", () => {
    actualizarMensaje("Este es el mensaje B", "text-rose-400");
  });
</script>