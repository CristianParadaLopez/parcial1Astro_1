---
//Agregartareas.astro
---

<style>
body{
    font-family:Segoe UI;
    background:linear-gradient(135deg,#5f9cff,#7d5fff);
    height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
}

.card{
    background:white;
    width:370px;
    padding:25px;
    border-radius:18px;
    box-shadow:0 15px 30px rgba(0,0,0,.25);
}

.input-group{
    display:flex;
}

input{
    flex:1;
    padding:12px;
    border-radius:12px 0 0 12px;
    border:1px solid #ddd;
    outline:none;
    font-size:15px;
}

.add{
    background:linear-gradient(45deg,#00c853,#43a047);
    border:none;
    color:white;
    padding:12px 18px;
    font-weight:bold;
    border-radius:0 12px 12px 0;
    cursor:pointer;
    transition:.2s;
}

.add:hover{
    transform:scale(1.05);
}

.seccion{
    margin-top:25px;
    background:#f4f6ff;
    padding:18px;
    border-radius:14px;
}

.seccion h3{
    text-align:center;
    margin:0 0 15px;
    color:#3f51b5;
}

ul{
    list-style:none;
    padding:0;
}

li{
    background:white;
    padding:14px;
    margin-bottom:12px;
    border-radius:12px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    box-shadow:0 4px 12px rgba(0,0,0,.12);
    border-left:6px solid #5c6bc0;
    animation:entrada .25s ease;
}

@keyframes entrada{
    from{opacity:0; transform:translateY(-8px)}
    to{opacity:1; transform:translateY(0)}
}

.texto{
    font-size:15px;
    color:#333;
    word-break:break-word;
}

.eliminar{
    background:linear-gradient(45deg,#ff5252,#d32f2f);
    border:none;
    color:white;
    padding:7px 12px;
    border-radius:10px;
    cursor:pointer;
    font-size:13px;
    font-weight:bold;
    transition:.2s;
}

.eliminar:hover{
    transform:scale(1.1);
}

.vacio{
    text-align:center;
    color:#999;
    font-size:14px;
}
</style>
</head>
<body>

<div class="card">

<div class="input-group">
<input id="input" placeholder="Escribe una tarea...">
<button class="add" id="agregar">Agregar</button>
</div>

<div class="seccion">
<h3>📝 Tareas pendientes</h3>
<ul id="lista"></ul>
<p id="vacio" class="vacio">No hay tareas aún</p>
</div>

</div>

<script>
// @ts-nocheck
const input = document.getElementById("input");
const lista = document.getElementById("lista");
const vacio = document.getElementById("vacio");

let tareas = JSON.parse(localStorage.getItem("tareas")) || [];
render();

document.getElementById("agregar").onclick=()=>{
    const texto=input.value.trim();
    if(!texto) return;

    tareas.push(texto);
    guardar();
    render();
    input.value="";
};

function render(){
    lista.innerHTML="";

    tareas.forEach((tarea,i)=>{
        const li=document.createElement("li");

        const span=document.createElement("span");
        span.textContent=tarea;
        span.className="texto";

        const btn=document.createElement("button");
        btn.textContent="Eliminar";
        btn.className="eliminar";

        btn.onclick=()=>{
            tareas.splice(i,1);
            guardar();
            render();
        };

        li.appendChild(span);
        li.appendChild(btn);
        lista.appendChild(li);
    });

    vacio.style.display=tareas.length?"none":"block";
}

function guardar(){
    localStorage.setItem("tareas",JSON.stringify(tareas));
}
</script>

</body>
</html>