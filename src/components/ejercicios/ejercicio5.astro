---
// components/ejercicios/AgregarTareas.astro
import LayoutEjercicio from '../../layouts/LayoutEjercicio.astro';
---

<LayoutEjercicio title="Gestor de Tareas">
  <div class="max-w-md mx-auto bg-slate-900 p-6 rounded-2xl shadow-2xl border border-slate-800">
    
    <div class="flex overflow-hidden rounded-xl border border-slate-700 focus-within:border-cyan-400 transition-all">
      <input 
        id="input" 
        type="text" 
        placeholder="Escribe una tarea..." 
        class="flex-1 bg-slate-800 p-3 text-white outline-none placeholder:text-slate-500"
      />
      <button 
        id="agregar" 
        class="bg-gradient-to-r from-emerald-500 to-teal-600 text-white px-5 font-bold hover:scale-105 transition-transform active:scale-95"
      >
        Agregar
      </button>
    </div>

    <div class="mt-8 bg-slate-800/50 p-5 rounded-xl border border-slate-700/50">
      <h3 class="text-center mb-4 text-cyan-400 font-bold flex items-center justify-center gap-2">
        <span>📝</span> Tareas pendientes
      </h3>
      
      <ul id="lista" class="space-y-3"></ul>
      
      <p id="vacio" class="text-center text-slate-500 text-sm mt-2">
        No hay tareas aún
      </p>
    </div>

  </div>
</LayoutEjercicio>

<script>
  const input = document.getElementById("input") as HTMLInputElement;
  const lista = document.getElementById("lista") as HTMLUListElement;
  const vacio = document.getElementById("vacio") as HTMLParagraphElement;
  const btnAgregar = document.getElementById("agregar") as HTMLButtonElement;

  let tareas: string[] = JSON.parse(localStorage.getItem("tareas") || "[]");
  
  const guardar = () => localStorage.setItem("tareas", JSON.stringify(tareas));

  const render = () => {
    if (!lista || !vacio) return;
    
    lista.innerHTML = "";
    
    tareas.forEach((tarea, i) => {
      const li = document.createElement("li");
      li.className = "flex justify-between items-center bg-slate-800 p-3 rounded-lg border-l-4 border-cyan-500 shadow-lg animate-in fade-in slide-in-from-top-2 duration-200";

      li.innerHTML = `
        <span class="text-slate-200 break-all mr-4">${tarea}</span>
        <button 
          class="eliminar-btn bg-gradient-to-r from-red-500 to-rose-600 text-white text-xs px-3 py-1.5 rounded-lg font-bold hover:scale-110 transition-transform"
          data-index="${i}"
        >
          Eliminar
        </button>
      `;

      lista.appendChild(li);
    });

    document.querySelectorAll('.eliminar-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const index = parseInt((e.currentTarget as HTMLButtonElement).dataset.index!);
        tareas.splice(index, 1);
        guardar();
        render();
      });
    });

    vacio.classList.toggle("hidden", tareas.length > 0);
  };

  btnAgregar.onclick = () => {
    const texto = input.value.trim();
    if (!texto) return;

    tareas.push(texto);
    guardar();
    render();
    input.value = "";
  };

  render();
</script>