<div class="container">
  <input type="text" id="userInput" placeholder="Escribe y presiona Enter" />
  <p id="output"></p>
</div>

<script>
  const input = document.getElementById('userInput') as HTMLInputElement;
  const output = document.getElementById('output');

  input.addEventListener('keydown', (event) => {
    if (event.key === 'Enter') {
      const value = input.value.trim();
      if (value !== "" && output) {
        output.textContent = value;
        input.value = "";
      }
    }
  });
</script>

<style>
  .container {
    font-family: sans-serif;
    padding: 20px;
  }
  input {
    padding: 8px;
    display: block;
    margin-bottom: 10px;
  }
  p {
    min-height: 1.5em;
  }
</style>