---
// components/ejercicios/Calculadora.astro
import LayoutEjercicio from '../../layouts/LayoutEjercicio.astro';
---

<LayoutEjercicio title="Calculadora Pro">
  <div class="max-w-xs mx-auto bg-slate-900 p-8 rounded-3xl shadow-2xl border border-slate-800 text-center">
    <h2 class="text-2xl font-bold text-white mb-6 tracking-tight">Calculadora</h2>

    <div class="space-y-3 mb-6">
      <input 
        id="n1" 
        type="number" 
        placeholder="Primer número" 
        class="w-full bg-slate-800 border border-slate-700 rounded-xl p-3 text-center text-white outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 transition-all placeholder:text-slate-500"
      />
      <input 
        id="n2" 
        type="number" 
        placeholder="Segundo número" 
        class="w-full bg-slate-800 border border-slate-700 rounded-xl p-3 text-center text-white outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 transition-all placeholder:text-slate-500"
      />
    </div>

    <div class="grid grid-cols-4 gap-2 mb-6">
      <button data-op="+" class="op-btn h-12 rounded-xl bg-slate-800 text-cyan-400 font-bold text-xl hover:bg-cyan-500 hover:text-slate-900 transition-all active:scale-90 border border-slate-700">+</button>
      <button data-op="-" class="op-btn h-12 rounded-xl bg-slate-800 text-cyan-400 font-bold text-xl hover:bg-cyan-500 hover:text-slate-900 transition-all active:scale-90 border border-slate-700">−</button>
      <button data-op="*" class="op-btn h-12 rounded-xl bg-slate-800 text-cyan-400 font-bold text-xl hover:bg-cyan-500 hover:text-slate-900 transition-all active:scale-90 border border-slate-700">×</button>
      <button data-op="/" class="op-btn h-12 rounded-xl bg-slate-800 text-cyan-400 font-bold text-xl hover:bg-cyan-500 hover:text-slate-900 transition-all active:scale-90 border border-slate-700">÷</button>
    </div>

    <div id="resultado" class="py-4 px-2 rounded-xl bg-slate-950 border border-slate-800 text-cyan-400 font-mono font-bold text-lg min-h-[60px] flex items-center justify-center">
      Resultado: —
    </div>
  </div>
</LayoutEjercicio>

<script>
  const botones = document.querySelectorAll(".op-btn");
  const resDisplay = document.getElementById("resultado");
  const inputN1 = document.getElementById("n1") as HTMLInputElement;
  const inputN2 = document.getElementById("n2") as HTMLInputElement;

  botones.forEach(btn => {
    btn.addEventListener("click", () => {
      const a = parseFloat(inputN1.value);
      const b = parseFloat(inputN2.value);
      const op = (btn as HTMLButtonElement).dataset.op;
      let r: string | number;

      if (isNaN(a) || isNaN(b)) {
        r = "Ingresa números";
      } else {
        switch (op) {
          case "+": r = a + b; break;
          case "-": r = a - b; break;
          case "*": r = a * b; break;
          case "/": 
            r = b === 0 ? "Error: ÷ 0" : (a / b).toLocaleString(); 
            break;
          default: r = 0;
        }
      }

      if (resDisplay) {
        resDisplay.innerHTML = `Resultado: <span class="ml-2 text-white">${r}</span>`;
      }
    });
  });
</script>