---
import '../../styles/global.css';
---

<div class="my-6 w-full max-w-md mx-auto">
  <label for="pokemon-search" class="block mb-2 text-sm font-medium text-white">
    Buscar Pokémon
  </label>
  <div class="relative">
    <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
      <svg class="w-4 h-4 text-gray-500" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20">
        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 19-4-4m0-7A7 7 0 1 1 1 8a7 7 0 0 1 14 0Z"/>
      </svg>
    </div>
    <input 
      type="search" 
      id="pokemon-search" 
      class="block w-full p-4 pl-10 text-sm text-gray-900 border border-gray-300 rounded-lg bg-gray-50 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all" 
      placeholder="Escribe el nombre de un Pokémon..." 
    />
  </div>

  <!-- Overlay de resultados -->
  <div 
    id="search-results" 
    class="hidden absolute z-50 w-full max-w-md bg-white border border-gray-200 rounded-lg shadow-lg mt-1 max-h-80 overflow-y-auto"
  >
  </div>
</div>

<script>
  const searchInput = document.getElementById('pokemon-search') as HTMLInputElement;
  const resultsBox = document.getElementById('search-results') as HTMLDivElement;

  // Cargamos la lista completa UNA sola vez (son solo nombres, muy liviano)
  let allPokemons: { name: string; id: string }[] = [];

  async function loadAllPokemons() {
    try {
      // limit=10000 trae todos los pokémon disponibles de una vez
      const res = await fetch('https://pokeapi.co/api/v2/pokemon?limit=10000');
      const data = await res.json();
      allPokemons = data.results.map((p: any) => {
        const id = p.url.split('/').filter(Boolean).pop();
        return { name: p.name, id };
      });
    } catch (e) {
      console.error('Error cargando pokémons', e);
    }
  }

  function renderResults(matches: { name: string; id: string }[]) {
    if (matches.length === 0) {
      resultsBox.innerHTML = `<p class="p-4 text-sm text-gray-500">No se encontró ningún Pokémon.</p>`;
      resultsBox.classList.remove('hidden');
      return;
    }

    // Mostramos máximo 10 sugerencias
    const html = matches.slice(0, 10).map(p => `
      <a 
        href="/proyecto-final/pokemon/${p.name}" 
        class="flex items-center gap-3 px-4 py-2 hover:bg-gray-100 transition-colors"
      >
        <img 
          src="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/${p.id}.png" 
          alt="${p.name}" 
          class="w-8 h-8"
          loading="lazy"
        />
        <span class="capitalize text-sm text-gray-800">${p.name}</span>
      </a>
    `).join('');

    resultsBox.innerHTML = html;
    resultsBox.classList.remove('hidden');
  }

  // Debounce para no disparar en cada tecla
  let debounceTimer: ReturnType<typeof setTimeout>;

  searchInput?.addEventListener('input', (e) => {
    const term = (e.target as HTMLInputElement).value.toLowerCase().trim();

    clearTimeout(debounceTimer);

    if (term.length < 2) {
      resultsBox.classList.add('hidden');
      return;
    }

    debounceTimer = setTimeout(() => {
      const matches = allPokemons.filter(p => p.name.includes(term));
      renderResults(matches);
    }, 300);
  });

  // Cerrar al hacer click fuera
  document.addEventListener('click', (e) => {
    if (!searchInput.contains(e.target as Node) && !resultsBox.contains(e.target as Node)) {
      resultsBox.classList.add('hidden');
    }
  });

  // Iniciamos la carga al montar el componente
  loadAllPokemons();
</script>