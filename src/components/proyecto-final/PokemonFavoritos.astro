---
// components/proyecto-final/PokemonFavoritos.astro
---

<div id="favorites-container" class="w-full">
    <div id="empty-state" class="hidden flex-col items-center justify-center py-24 text-center bg-slate-900/20 border-2 border-dashed border-slate-800 rounded-[3rem]">
        <div class="w-24 h-24 bg-slate-900 rounded-full flex items-center justify-center mb-6 shadow-xl">
            <span class="text-5xl">⭐</span>
        </div>
        <h2 class="text-3xl font-black text-white mb-3">Tu colección está vacía</h2>
        <p class="text-slate-500 mb-8 max-w-sm mx-auto font-medium">
            Explora el Pokédex y guarda tus Pokémon preferidos para verlos aquí.
        </p>
        <a href="/proyecto-final/pokemon" class="inline-flex items-center gap-2 bg-yellow-500 hover:bg-yellow-400 text-slate-950 px-8 py-3 rounded-2xl font-black transition-all hover:scale-105 shadow-lg shadow-yellow-500/10">
            <span>🔎</span> Explorar Pokémon
        </a>
    </div>

    <div id="favorites-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-6"></div>
</div>

<script>
    // Definimos la función globalmente para que no haya errores de alcance
    function initFavorites() {
        const grid = document.getElementById('favorites-grid');
        const emptyState = document.getElementById('empty-state');
        
        if (!grid || !emptyState) return;

        // Intentar obtener favoritos
        const favsRaw = localStorage.getItem('pokemon-favorites');
        const favs = favsRaw ? JSON.parse(favsRaw) : [];

        if (favs.length === 0) {
            emptyState.classList.remove('hidden');
            emptyState.classList.add('flex');
            grid.innerHTML = '';
            return;
        }

        emptyState.classList.add('hidden');
        emptyState.classList.remove('flex');

        // Renderizar las tarjetas
        grid.innerHTML = favs.map((pokemon: { id: number; name: string; image: string }) => `
            <div class="group relative bg-slate-900/50 border border-slate-800 rounded-3xl p-4 transition-all duration-300 hover:border-pink-500/50 hover:-translate-y-2 backdrop-blur-xl shadow-xl">
                
                <button
                    class="remove-fav absolute -top-2 -right-2 z-20 w-10 h-10 flex items-center justify-center rounded-xl bg-slate-950 border border-slate-800 text-pink-500 shadow-2xl hover:bg-pink-500 hover:text-white transition-all active:scale-90"
                    data-id="${pokemon.id}"
                >
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"/></svg>
                </button>

                <div class="aspect-square bg-slate-950/50 rounded-2xl flex justify-center items-center mb-4 overflow-hidden group-hover:bg-slate-950 transition-colors">
                    <img src="${pokemon.image}" alt="${pokemon.name}" class="w-28 h-28 object-contain drop-shadow-[0_0_15px_rgba(255,255,255,0.1)] group-hover:scale-110 transition-transform duration-500" />
                </div>

                <div class="space-y-1 text-center">
                    <span class="text-[10px] font-black text-slate-600 uppercase tracking-widest">#${String(pokemon.id).padStart(3, '0')}</span>
                    <h2 class="text-base font-bold text-white capitalize truncate">${pokemon.name}</h2>
                </div>

                <a 
                    href="/proyecto-final/pokemon/${pokemon.id}" 
                    class="mt-4 block text-center bg-slate-800 hover:bg-slate-700 text-slate-200 text-[10px] font-black py-3 rounded-xl transition-colors uppercase tracking-widest"
                >
                    Detalles
                </a>
            </div>
        `).join('');

        // Agregar eventos a los botones de borrar
        const buttons = grid.querySelectorAll('.remove-fav');
        buttons.forEach((btn) => {
            btn.addEventListener('click', (e) => {
                const id = parseInt(btn.getAttribute('data-id') || '0', 10);
                const currentFavs = JSON.parse(localStorage.getItem('pokemon-favorites') || '[]');
                const newFavs = currentFavs.filter((p: { id: number; name: string; image: string }) => p.id != id);
                localStorage.setItem('pokemon-favorites', JSON.stringify(newFavs));
                initFavorites(); // Recargar la vista
            });
        });
    }

    // EJECUCIÓN: Esto es lo que asegura que cargue siempre
    initFavorites(); // Ejecutar al cargar el script
    
    // Para cuando navegas usando ViewTransitions de Astro
    document.addEventListener('astro:after-swap', initFavorites);
    document.addEventListener('astro:page-load', initFavorites);
</script>